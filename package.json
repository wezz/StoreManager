{
  "name": "@wezz/store-manager",
  "version": "0.1.16",
  "description": "A script to manage local and session storage",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:exports": "publint && attw --pack",
    "prepare": "npm run build",
    "pack": "npm run build",
    "prepublishOnly": "npm run build && publint",
    "trypublish": "npm publish --access public || true",
    "eslint": "eslint --ext .ts --fix",
    "prettier": "prettier --write \"**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wezz/StoreManager.git"
  },
  "author": "Wezz Balk <github@wezz.se> (https://github.com/wezz)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wezz/StoreManager/issues"
  },
  "homepage": "https://github.com/wezz/StoreManager",
  "keywords": [
    "helper",
    "localstorage",
    "sessionstorage",
    "window"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.14.1",
    "eslint": "^9.39.4",
    "prettier": "^3.5.3",
    "publint": "^0.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.4.2",
    "vite-plugin-dts": "^4.5.3"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.12"
  }
}
